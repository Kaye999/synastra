# Copy this file to .env.local and fill in real values.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Clerk (auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- Supabase (DB) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Stripe (payments) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Synastra has 3 paid tiers — each with a monthly recurring and yearly one-time price.
# Tier codenames: reader=The Five, depth=The Seven, master=The Nine.
# Live price IDs (Stripe) — currency AUD. Code falls back to these IDs if env empty.
NEXT_PUBLIC_STRIPE_READER_MONTHLY=price_1TZUsu2EI3wlD7djHDuLeEqR   # A$11.10/mo  (The Five)
NEXT_PUBLIC_STRIPE_READER_ONETIME=price_1TZUsv2EI3wlD7djukNPgUla   # A$77.70/yr  (The Five)
NEXT_PUBLIC_STRIPE_DEPTH_MONTHLY=price_1TZUsw2EI3wlD7djGFp374AK    # A$22.20/mo  (The Seven)
NEXT_PUBLIC_STRIPE_DEPTH_ONETIME=price_1TZUsx2EI3wlD7djiQlsLPvq    # A$155.40/yr (The Seven)
NEXT_PUBLIC_STRIPE_MASTER_MONTHLY=price_1TZUt62EI3wlD7djDPZ0BioG   # A$33.30/mo  (The Nine)
NEXT_PUBLIC_STRIPE_MASTER_ONETIME=price_1TZUt82EI3wlD7djFNxGfqLO   # A$233.10/yr (The Nine)

# ---- Anthropic (AI chat) ----
ANTHROPIC_API_KEY=sk-ant-xxx

# ---- Resend (transactional email) ----
# Sign up at resend.com, verify 'getsynastra.com' domain, then paste API key here.
# Free tier = 3,000 emails/mo (covers ~100 users at 1 alert/day).
RESEND_API_KEY=re_xxx

# ---- Vercel Cron auth ----
# Generate a random 32-char hex string, e.g. `openssl rand -hex 32`.
# Vercel cron sends this as `Authorization: Bearer <CRON_SECRET>` automatically
# when the env var is defined in the Vercel project.
CRON_SECRET=replace_with_random_32_char_hex
